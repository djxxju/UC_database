{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kazarlis 1996 六规模表格输入 profile 0.1.0",
  "type": "object",
  "required": [
    "profile",
    "case_family",
    "generator_count",
    "horizon_hours",
    "time_step_hours",
    "generators",
    "time_series",
    "reserve_rule",
    "field_units",
    "case_id",
    "documentation"
  ],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "kazarlis1996-table-inputs/0.1.0"
    },
    "case_family": {
      "const": "kazarlis1996"
    },
    "case_id": {
      "enum": [
        "kazarlis1996_uc10_inputs_v1",
        "kazarlis1996_uc20_inputs_v1",
        "kazarlis1996_uc40_inputs_v1",
        "kazarlis1996_uc60_inputs_v1",
        "kazarlis1996_uc80_inputs_v1",
        "kazarlis1996_uc100_inputs_v1"
      ]
    },
    "generator_count": {
      "enum": [
        10,
        20,
        40,
        60,
        80,
        100
      ]
    },
    "horizon_hours": {
      "const": 24
    },
    "time_step_hours": {
      "const": 1
    },
    "generators": {
      "type": "array",
      "minItems": 10,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "pmax_mw",
          "pmin_mw",
          "cost_a",
          "cost_b",
          "cost_c",
          "min_up_hours",
          "min_down_hours",
          "hot_start_cost",
          "cold_start_cost",
          "cold_start_hrs",
          "initial_status_hours",
          "source_unit_id",
          "copy_index"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "pmax_mw": {
            "type": "number",
            "minimum": 0
          },
          "pmin_mw": {
            "type": "number",
            "minimum": 0
          },
          "cost_a": {
            "type": "number"
          },
          "cost_b": {
            "type": "number"
          },
          "cost_c": {
            "type": "number"
          },
          "min_up_hours": {
            "type": "integer",
            "minimum": 0
          },
          "min_down_hours": {
            "type": "integer",
            "minimum": 0
          },
          "hot_start_cost": {
            "type": "number"
          },
          "cold_start_cost": {
            "type": "number"
          },
          "cold_start_hrs": {
            "type": "integer",
            "minimum": 0
          },
          "initial_status_hours": {
            "type": "integer"
          },
          "source_unit_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "copy_index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        }
      }
    },
    "time_series": {
      "type": "object",
      "required": [
        "hour",
        "demand_mw",
        "reserve_mw"
      ],
      "additionalProperties": false,
      "properties": {
        "hour": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          }
        },
        "demand_mw": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "reserve_mw": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "reserve_rule": {
      "const": {
        "type": "fraction_of_demand",
        "fraction": 0.1
      }
    },
    "field_units": {
      "const": {
        "id": "1",
        "pmax_mw": "MW",
        "pmin_mw": "MW",
        "cost_a": "$/h",
        "cost_b": "$/MWh",
        "cost_c": "$/(MW²·h)",
        "min_up_hours": "h",
        "min_down_hours": "h",
        "hot_start_cost": "$",
        "cold_start_cost": "$",
        "cold_start_hrs": "h",
        "initial_status_hours": "h",
        "hour": "h",
        "demand_mw": "MW",
        "reserve_mw": "MW",
        "source_unit_id": "1",
        "copy_index": "1"
      }
    },
    "documentation": {
      "const": {
        "source": "provenance.json",
        "issues": "issues.json"
      }
    }
  }
}
